  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "keywords": [
    "game-server",
    "monitoring",
    "dashboard",
    "gamedig",
    "minecraft",
    "cs2",
    "fivem",
    "source-engine",
    "rcon",
    "status"
  ],
  "author": "Zver1o7",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "gamedig": "^5.1.4",
    "socket.io": "^4.8.1",
    "node-cron": "^3.0.3"
  }
}
